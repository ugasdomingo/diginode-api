# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/digiempresas

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars

# Anthropic (Claude) — motor de Nora en la demo y en los canales comerciales
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — motor del agente que responde DMs y comentarios de Instagram
OPENAI_API_KEY=sk-...

# Airtable — AQUI VIVEN LAS CONVERSACIONES DE INSTAGRAM Y LAS FAQs.
# Sin este token, la seccion Conversaciones del panel deja de funcionar.
AIRTABLE_PAT=pat...

# Instagram / Meta — webhooks de DMs y comentarios
INSTAGRAM_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# Slack — avisos internos (cliente que paga, inscripcion a taller, errores)
DIGINODE_OPS_SLACK_WEBHOOK=
OPS_SLACK_TIMEOUT_MS=5000

# Make.com — escenarios externos. Si no los usas, deja las URLs vacias:
# la seccion Contenido del panel depende de MAKE_CONTENT_WEBHOOK_URL.
MAKE_CONTENT_WEBHOOK_URL=
MAKE_RECEPCIONISTA_WEBHOOK_URL=

# Salud de las oficinas desplegadas (panel Oficinas)
OFFICES_HEALTH_TIMEOUT_MS=5000
OFFICES_HEALTH_CACHE_TTL_MS=60000

# Nivel de log (debug | info | warn | error)
LOG_LEVEL=info

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.0-pro
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Webhooks secrets (shared secrets with Make.com and Cal.com)
MAKE_WEBHOOK_SECRET=change_this_to_a_random_secret
CAL_WEBHOOK_SECRET=change_this_to_a_random_secret

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hola@tuagencia.com

# Cal.com
CAL_BOOKING_LINK=https://cal.com/tu-usuario/reunion-inicial

# Analitica propia: secreto que entra en el hash diario del visitante. Ponle un
# valor largo y aleatorio en produccion. Sin el, el hash sigue siendo
# irreversible pero un tercero con la misma IP podria recalcularlo.
ANALYTICS_SALT=change_this_to_a_long_random_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Secuencia de seguimiento de leads (F3-5). Ponlo a true SOLO en produccion
# para que el cron horario envie los emails de seguimiento (D+1/3/7/14).
ENABLE_FOLLOWUPS=false

# Public repositioning. Keep old Stripe return until the new client is available.
CLINICA_RETURN_PATH=/
DEMO_DAILY_LIMIT=300
# No automatic opt-in: followups also require marketing_authorized_at and digital_clinic offer.

# ── Núcleo operativo de la agencia ──────────────────────────────────────────
# Caja fuerte de accesos de clientes (AES-256-GCM). 32 bytes en base64 o 64 hex.
# Sin esta clave la API arranca, pero cifrar o descifrar responde 503.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_VAULT_KEY=

# Segundo factor de los clientes (email + contraseña, luego código de 6 dígitos).
# Activo salvo que pongas false. Domingo (admin) no usa este segundo paso.
# No despliegues hasta que el portal sepa pedir el código.
CLIENT_2FA_REQUIRED=true

# Correo del código y del alta de portal. resend | webhook | log
# resend reutiliza RESEND_API_KEY y, si no indicas remitente, RESEND_FROM_EMAIL.
OTP_EMAIL_PROVIDER=resend
OTP_EMAIL_FROM=
OTP_EMAIL_WEBHOOK_URL=
# Opcional. Si está vacío, el hash del código usa JWT_SECRET.
OTP_PEPPER=

# Avisos de aprobación y de facturas. Una línea y un enlace, nunca el contenido.
# Si AGENCY_SLACK_WEBHOOK_URL está vacío se usa DIGINODE_OPS_SLACK_WEBHOOK.
AGENCY_SLACK_WEBHOOK_URL=
# Webhook JSON para bots. Opcional. El historial también se lee en GET /api/agency/events.
AGENCY_EVENT_WEBHOOK_URL=
# Base de los enlaces de los avisos (pantalla de la agencia en el cliente).
AGENCY_APP_URL=https://midiginode.com/agencia

# Las facturas de agencia reutilizan STRIPE_SECRET_KEY y STRIPE_WEBHOOK_SECRET.
# En pruebas usa sk_test_... y el secreto whsec_ del endpoint de test.
# El webhook sigue siendo POST /api/webhooks/stripe (evento checkout.session.completed).
